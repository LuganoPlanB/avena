if(NOT IS_DIRECTORY "${prefix}/include/avena")
    message(FATAL_ERROR "Missing include/avena")
endif()
foreach(header IN ITEMS Environment.hpp websocket/Handshaker.hpp openssl/Config.hpp macro/codegen.hpp)
    if(NOT EXISTS "${prefix}/include/avena/${header}")
        message(FATAL_ERROR "Missing public header: avena/${header}")
    endif()
endforeach()
file(GLOB_RECURSE files RELATIVE "${prefix}" "${prefix}/*")
foreach(file IN LISTS files)
    if(file MATCHES "(^|/)(liboat[^/]*|oatpp[^/]*)(/|$)")
        message(FATAL_ERROR "Legacy installed artifact: ${file}")
    endif()
endforeach()
if(static)
    file(GLOB_RECURSE archives RELATIVE "${prefix}" "${prefix}/*.a")
    list(LENGTH archives count)
    if(NOT count EQUAL 1 OR NOT archives MATCHES "(^|/)libavena\\.a$")
        message(FATAL_ERROR "Expected only libavena.a; got: ${archives}")
    endif()
endif()
message(STATUS "Verified avena headers and library install layout")
