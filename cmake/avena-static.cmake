# Resolve static TLS dependencies, retaining only platform runtime link flags.
function(avena_collect_static item)
    get_property(seen GLOBAL PROPERTY AVENA_STATIC_SEEN)
    if(item IN_LIST seen)
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY AVENA_STATIC_SEEN "${item}")
    if(item STREQUAL "Threads::Threads" OR item MATCHES "^(-pthread|pthread|dl|atomic|m|ws2_32|wsock32|crypt32|bcrypt)$")
        set_property(GLOBAL APPEND PROPERTY AVENA_RUNTIME_LINKS "${item}")
    elseif(TARGET "${item}")
        get_target_property(location "${item}" IMPORTED_LOCATION)
        if(NOT location)
            foreach(config IN ITEMS RELEASE RELWITHDEBINFO NOCONFIG DEBUG)
                get_target_property(location "${item}" "IMPORTED_LOCATION_${config}")
                if(location)
                    break()
                endif()
            endforeach()
        endif()
        if(location)
            if(NOT location MATCHES "\\.(a|lib)$")
                message(FATAL_ERROR "Static avena requires a static dependency: ${item} -> ${location}")
            endif()
            set_property(GLOBAL APPEND PROPERTY AVENA_TLS_ARCHIVES "${location}")
        endif()
        get_target_property(links "${item}" INTERFACE_LINK_LIBRARIES)
        if(links)
            foreach(link IN LISTS links)
                string(REGEX REPLACE "^\\$<LINK_ONLY:(.*)>$" "\\1" link "${link}")
                avena_collect_static("${link}")
            endforeach()
        endif()
    elseif(IS_ABSOLUTE "${item}" AND item MATCHES "\\.(a|lib)$")
        set_property(GLOBAL APPEND PROPERTY AVENA_TLS_ARCHIVES "${item}")
    else()
        string(REGEX REPLACE "^-l" "" name "${item}")
        set(CMAKE_FIND_LIBRARY_SUFFIXES .a .lib)
        unset(archive CACHE)
        find_library(archive NAMES "${name}" REQUIRED)
        set_property(GLOBAL APPEND PROPERTY AVENA_TLS_ARCHIVES "${archive}")
    endif()
endfunction()

function(avena_bundle_tls target)
    set_property(GLOBAL PROPERTY AVENA_STATIC_SEEN "")
    set_property(GLOBAL PROPERTY AVENA_TLS_ARCHIVES "")
    set_property(GLOBAL PROPERTY AVENA_RUNTIME_LINKS "")
    avena_collect_static(OpenSSL::SSL)
    avena_collect_static(OpenSSL::Crypto)
    get_property(archives GLOBAL PROPERTY AVENA_TLS_ARCHIVES)
    get_property(runtime GLOBAL PROPERTY AVENA_RUNTIME_LINKS)
    list(REMOVE_DUPLICATES archives)
    list(REMOVE_DUPLICATES runtime)
    target_link_libraries(${target} PUBLIC ${runtime})
    set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS ${archives}
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/merge-archives.cmake")
    set(manifest "${CMAKE_CURRENT_BINARY_DIR}/avena-tls-archives.cmake")
    file(WRITE "${manifest}" "set(archives [==[${archives}]==])\n")
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND}
            "-Dlibrary=$<TARGET_FILE:${target}>" "-Dmanifest=${manifest}"
            "-Darchiver=${CMAKE_AR}" "-Dapple=${APPLE}" "-Dmsvc=${MSVC}"
            -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/merge-archives.cmake"
        COMMENT "Merging TLS dependencies into libavena" VERBATIM)
endfunction()
